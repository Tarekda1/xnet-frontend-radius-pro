## Frontend environment (Vite)
## Copy to `.env.local` (recommended) and adjust values.
##
## Windows (PowerShell):
##   Copy-Item env.example .env.local

# API base URL used by the frontend (Vite will inline this at build time)
VITE_API_URL=https://radius.xnetcloud.tech/api

# Optional websocket URL (only if your UI uses it)
# VITE_WS_URL=ws://localhost:15674

# Optional defaults for NAS CoA actions (Online Users -> Disconnect)
VITE_DEFAULT_NAS_IP=172.8.16.200
VITE_DEFAULT_NAS_SECRET=
VITE_DEFAULT_NAS_COA_PORT=1700

# Optional: override local dev port when using docker-compose
# PORT=5173

