{
  "name": "xnet-frontend-radius-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix next-app",
    "build": "npm run build --prefix next-app",
    "start": "npm run start --prefix next-app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --prefix next-app",
    "next:dev": "npm run dev --prefix next-app",
    "next:build": "npm run build --prefix next-app",
    "next:start": "npm run start --prefix next-app",
    "docker:dev:build": "docker compose --profile dev build",
    "docker:dev:up": "docker compose --profile dev up",
    "docker:dev": "docker compose --profile dev up",
    "docker:dev:stop": "docker compose --profile dev down",
    "docker:prod:build": "docker compose --profile prod build",
    "docker:prod:up": "docker compose --profile prod up -d --build",
    "docker:prod:down": "docker compose --profile prod down",
    "docker:prod": "docker compose --profile prod up -d --build",
    "docker:stop": "docker compose down",
    "docker:clean": "docker compose down -v && docker builder prune -f",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "npm run docker:clean && npm run docker:dev",
    "test": "npm run test --prefix next-app",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "win:dev": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\dev.ps1",
    "win:docker:dev": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-dev.ps1",
    "win:docker:down": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-down.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@playwright/test": "^1.57.0",
    "@typescript-eslint/eslint-plugin": "8.24.1",
    "@typescript-eslint/parser": "8.24.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^13.24.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "typescript": "^5.3.3"
  }
}
