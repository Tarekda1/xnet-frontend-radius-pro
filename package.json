{
  "name": "xnet-frontend-radius-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix next-app",
    "build": "npm run build --prefix next-app",
    "start": "npm run start --prefix next-app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --prefix next-app",
    "next:dev": "npm run dev --prefix next-app",
    "next:build": "npm run build --prefix next-app",
    "next:start": "npm run start --prefix next-app",
    "docker:dev:build": "docker compose --profile dev build",
    "docker:dev:up": "docker compose --profile dev up",
    "docker:dev": "docker compose --profile dev up",
    "docker:dev:stop": "docker compose --profile dev down",
    "docker:prod:build": "docker compose --profile prod build",
    "docker:prod:up": "docker compose --profile prod up -d --build",
    "docker:prod:down": "docker compose --profile prod down",
    "docker:prod": "docker compose --profile prod up -d --build",
    "docker:stop": "docker compose down",
    "docker:clean": "docker compose down -v && docker builder prune -f",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "npm run docker:clean && npm run docker:dev",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "win:dev": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\dev.ps1",
    "win:docker:dev": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-dev.ps1",
    "win:docker:down": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-down.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/react": "^10.37.0",
    "@stomp/stompjs": "^7.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tanstack/react-query": "^5.17.19",
    "@tanstack/react-table": "^8.21.2",
    "@types/react-helmet": "^6.1.11",
    "@typescript-eslint/eslint-plugin": "8.24.1",
    "@typescript-eslint/parser": "8.24.1",
    "axios": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.16.0",
    "i18next": "^26.0.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.475.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react": "^19.0.0",
    "react-day-picker": "9.6.0",
    "react-dom": "^19.0.0",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.2",
    "react-icons": "^5.5.0",
    "react-transition-group": "^4.4.5",
    "recharts": "^2.15.3",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.8",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/stompjs": "^2.3.9",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^13.24.0",
    "jest": "^27.0.6",
    "postcss": "^8.5.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^0.0.1-alpha.0"
  }
}
